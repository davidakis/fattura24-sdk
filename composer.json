{
    "name": "simplyit/fattura24-sdk",
    "description": "PHP SDK for Fattura24.com API - Italian electronic invoicing",
    "type": "library",
    "license": "MIT",
    "version": "2.1.2",
    "keywords": ["fattura24", "electronic invoice", "fattura elettronica", "italy", "sdi"],
    "authors": [
        {
            "name": "SimplyIT",
            "email": "info@simplyit.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.48",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "SimplyIT\\Fattura24SDK\\": "src/"
        }
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix --verbose",
        "cs-check": "php-cs-fixer fix --dry-run --diff --verbose",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": [
            "@cs-check",
            "@stan",
            "phpunit"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
